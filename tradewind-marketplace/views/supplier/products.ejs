<%- include('../partials/app-start') %>
<div class="page-h"><div><h1>Products & stock</h1><p class="muted mb0">Listings feed search results and RFQ matching. Keep stock levels current.</p></div><a class="btn btn-primary" href="/supplier/products/new">+ Add product</a></div>
<% if (!rows.length) { %><div class="card empty"><h3>No products yet</h3><p>Add your first product or capability so buyers and the matching engine can find you.</p><a class="btn btn-primary" href="/supplier/products/new">Add product</a></div><% } else { %>
<div class="table-wrap"><table>
  <tr><th>Product</th><th>Category</th><th>Availability</th><th>Stock</th><th>MOQ</th><th>Price</th><th>Views</th><th></th></tr>
  <% rows.forEach(p => { %><tr>
    <td><a href="/products/<%= p.id %>"><b><%= p.name %></b></a><br><small><%= p.material %> <%= p.grade %></small> <% if (p.status==='hidden') { %><%- include('../partials/badge', { s: 'hidden' }) %><% } %></td>
    <td><%= p.category %></td><td><%- include('../partials/badge', { s: p.availability }) %></td>
    <td><form method="post" action="/supplier/products/<%= p.id %>/stock" class="row" style="gap:4px;flex-wrap:nowrap"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="number" step="any" name="stock_qty" value="<%= p.stock_qty %>" style="width:90px;padding:6px"><button class="btn btn-outline btn-sm" title="Update stock">✓</button></form><small><%= p.unit %></small></td>
    <td><%= h.num(p.moq) %></td><td><%= h.money(p.price, p.currency) %></td><td><%= p.views %></td>
    <td class="row" style="flex-wrap:nowrap"><a class="btn btn-outline btn-sm" href="/supplier/products/<%= p.id %>/edit">Edit</a>
      <form method="post" action="/supplier/products/<%= p.id %>/delete" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger btn-sm" data-confirm="Delete this product?">Delete</button></form></td>
  </tr><% }) %>
</table></div><% } %>
<%- include('../partials/app-end') %>
