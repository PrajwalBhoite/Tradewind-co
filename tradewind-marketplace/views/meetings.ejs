<%- include('partials/app-start') %>
<small class="muted">Meetings</small>
<div class="page-h"><div><h1>🤝 Meetings</h1><p class="muted mb0">Request a virtual meeting with a buyer or supplier once an RFQ has been shared. Meetings run on Zoom, Microsoft Teams or Google Meet. Times are shown in your time zone (<%= myTz %>).</p></div></div>
<div class="grid" style="grid-template-columns:1fr 1.35fr;align-items:start">
  <div class="card"><h2>📅 New meeting request</h2>
    <% if (!pairs.length) { %><div class="empty">Meetings become available after an RFQ is shared between you and the other party (for confidential RFQs: after the NDA is signed by both).</div><% } else { %>
    <form method="post" action="/meetings"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field"><label>Related RFQ & meeting with *</label><select name="pair" required><option value="">Select…</option>
        <% pairs.forEach(p => { const k = p.rid + ':' + p.cid; %><option value="<%= k %>" <%= pre===k?'selected':'' %>><%= p.ref %> · <%= p.name %></option><% }) %></select></div>
      <div class="field"><label>Meeting purpose *</label><select name="purpose"><% PURPOSES.forEach(p => { %><option><%= p %></option><% }) %></select></div>
      <div class="grid g2">
        <div class="field"><label>Preferred date *</label><input type="date" name="date" min="<%= today %>" required></div>
        <div class="field"><label>Preferred time *</label><input type="time" name="time" required value="10:30"></div>
        <div class="field"><label>Time zone</label><select name="timezone" data-default-tz><% zones.forEach(z => { %><option value="<%= z[0] %>" <%= z[0]===myTz?'selected':'' %>><%= z[1] %></option><% }) %></select></div>
        <div class="field"><label>Duration</label><select name="duration_min"><% [30,45,60,90,120].forEach(d => { %><option value="<%= d %>" <%= d===60?'selected':'' %>><%= d %> min</option><% }) %></select></div>
      </div>
      <div class="field"><label>Meeting description</label><textarea name="description" rows="3" placeholder="Agenda, who should attend (engineering, quality…), documents to review"></textarea></div>
      <div class="grid g2">
        <div class="field"><label>Alternative slot</label><input type="text" name="alt_slot" placeholder="e.g. Fri 07 Nov · 09:00"></div>
        <div class="field"><label>Meeting mode</label><select name="mode"><option value="online">Online (video)</option><option value="in_person">In person / factory visit</option></select></div>
        <div class="field" data-online><label>Preferred platform</label><select name="platform"><% Object.entries(PLATFORMS).forEach(([k, v]) => { %><option value="<%= k %>"><%= v %></option><% }) %></select></div>
        <div class="field" data-inperson style="display:none"><label>Location</label><input type="text" name="location" placeholder="Factory address / office"></div>
        <div class="field" data-online><label>Meeting link (optional)</label><input type="url" name="link" placeholder="https://…"></div>
      </div>
      <button class="btn btn-primary btn-block btn-lg">➤ Request meeting</button>
    </form><% } %>
  </div>
  <div class="card"><div class="card-h"><h2>My meetings</h2></div>
    <% if (!meetings.length) { %><div class="empty">No meetings yet.</div><% } %>
    <% meetings.forEach(m => { %><%- include('partials/meeting-card', { m, other: m.other, myTurn: m.myTurn, isAdmin: false, viewTz: myTz }) %><% }) %>
    <div class="alert alert-info">Status flow: Requested → Accepted (TradeWind helps coordinate time zones) → Confirmed (link issued) → Completed (minutes logged). Either party can propose a new time.</div>
  </div>
</div>
<%- include('partials/app-end') %>
