<%- include('../partials/app-start') %>
<h1>Industries & categories</h1>
<form method="post" class="card row" style="margin-bottom:16px"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="text" name="industry" placeholder="Industry (existing or new)" list="inds" required style="max-width:300px"><datalist id="inds"><% [...new Set(rows.map(r => r.industry))].forEach(i => { %><option value="<%= i %>"><% }) %></datalist>
  <input type="text" name="name" placeholder="Category name" required style="max-width:300px"><button class="btn btn-primary">Add category</button></form>
<div class="table-wrap"><table><tr><th>Industry</th><th>Category</th><th>Products</th><th></th></tr>
<% rows.forEach(c => { %><tr><td><%= c.industry %></td><td><%= c.name %></td><td><%= c.products %></td><td><form method="post" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= c.id %>"><button class="btn btn-danger btn-sm" name="action" value="delete" data-confirm="Delete category?">Delete</button></form></td></tr><% }) %>
</table></div>
<%- include('../partials/app-end') %>
