<%- include('../partials/app-start') %>
<h1>Companies & verification</h1>
<form class="row" style="margin-bottom:16px" data-autosubmit><input type="search" name="q" value="<%= q %>" placeholder="Search name or country" style="max-width:280px">
  <select name="status" style="max-width:220px"><option value="">All statuses</option><% ['pending','verified','unverified','rejected'].forEach(x => { %><option value="<%= x %>" <%= status===x?'selected':'' %>><%= h.label(x) %></option><% }) %></select><button class="btn btn-outline">Filter</button></form>
<div class="table-wrap"><table>
  <tr><th>Company</th><th>Role</th><th>Country</th><th>Verification</th><th>Plan</th><th>Status</th><th>Joined</th><th></th></tr>
  <% rows.forEach(c => { %><tr><td><b><%= c.name %></b><br><small><%= c.email %></small></td><td><%= [c.is_buyer?'Buyer':'', c.is_supplier?'Supplier':''].filter(Boolean).join(' + ') %><br><small><%= c.business_type %></small></td>
    <td><%= c.country %></td><td><%- include('../partials/badge', { s: c.verification_status }) %></td><td><%= c.plan %><%= c.featured ? ' ★' : '' %></td>
    <td><%- include('../partials/badge', { s: c.status }) %></td><td><small><%= h.date(c.created_at) %></small></td><td><a class="btn btn-outline btn-sm" href="/admin/companies/<%= c.id %>">Review</a></td></tr><% }) %>
</table></div>
<%- include('../partials/app-end') %>
