<%- include('../partials/app-start') %>
<div class="page-h"><div><small><a href="/admin/companies">← Companies</a></small><h1><%= c.name %></h1><div class="row"><%- include('../partials/badge', { s: c.verification_status }) %><%- include('../partials/badge', { s: c.status }) %><span class="badge"><%= c.plan %></span></div></div>
  <a class="btn btn-outline" href="/companies/<%= c.id %>" target="_blank">Public profile ↗</a></div>
<div class="grid" style="grid-template-columns:1.4fr 1fr">
  <div class="card"><h3>Company details</h3>
    <dl class="kv"><dt>Type</dt><dd><%= c.business_type %> (<%= [c.is_buyer?'Buyer':'', c.is_supplier?'Supplier':''].filter(Boolean).join(' + ') %>)</dd>
      <dt>Registration no.</dt><dd><%= c.reg_number || '—' %></dd><dt>Tax ID</dt><dd><%= c.tax_id || '—' %></dd>
      <dt>Address</dt><dd><%= c.address || '—' %>, <%= c.city %>, <%= c.country %></dd><dt>Website</dt><dd><%= c.website || '—' %></dd><dt>Phone</dt><dd><%= c.phone || '—' %></dd>
      <dt>Established</dt><dd><%= c.year_established || '—' %></dd><dt>Certifications</dt><dd><%= c.certifications || '—' %></dd>
      <dt>Capabilities</dt><dd><%= c.capabilities || '—' %></dd><dt>Capacity</dt><dd><%= c.production_capacity || '—' %></dd>
      <dt>Verification doc</dt><dd><% if (c.verification_doc) { %><a href="/files/verification/<%= c.id %>">Download</a><% } else { %>None uploaded<% } %></dd>
      <dt>Trust score</dt><dd><%= h.trustScore(c) %>/100</dd></dl>
    <h3 class="mt">Users</h3><% users.forEach(u => { %><div><%= u.name %> · <%= u.email %> · <small>last login <%= u.last_login ? h.ago(u.last_login) : 'never' %></small></div><% }) %>
    <h3 class="mt">Products (<%= products.length %>)</h3><% products.slice(0,10).forEach(p => { %><div><a href="/products/<%= p.id %>"><%= p.name %></a> <small>· <%= p.status %></small></div><% }) %>
  </div>
  <div>
    <div class="card"><h3>KYB decision</h3>
      <form method="post"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field"><label>Note to company (optional)</label><textarea name="note" rows="2"><%= c.verification_note || '' %></textarea></div>
        <div class="row"><button class="btn btn-green" name="action" value="verify">✔ Verify</button><button class="btn btn-danger" name="action" value="reject">Reject</button></div>
      </form></div>
    <div class="card"><h3>Membership & visibility</h3>
      <form method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="plan">
        <div class="field"><label>Plan</label><select name="plan"><% ['free','premium','enterprise'].forEach(p => { %><option <%= c.plan===p?'selected':'' %>><%= p %></option><% }) %></select></div>
        <label class="check"><input type="checkbox" name="featured" value="1" <%= c.featured?'checked':'' %>> Sponsored / featured company</label>
        <button class="btn btn-navy mt">Save</button></form></div>
    <div class="card"><h3>Account status</h3>
      <form method="post"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <% if (c.status==='active') { %><button class="btn btn-danger" name="action" value="suspend" data-confirm="Suspend this company and its users?">Suspend company</button><% } else { %><button class="btn btn-green" name="action" value="activate">Re-activate</button><% } %>
      </form></div>
  </div>
</div>
<%- include('../partials/app-end') %>
